@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature Users — GET ALL / GET ONE
### Leyenda: SIN AUTH (temporal hasta ISS-21). Nunca devuelve `password`.
@baseUrl = http://localhost:4000
@id = 1

# @name getAllUsers
GET {{baseUrl}}/api/usuarios
Authorization: Bearer {{token}}

###

# @name getOneUser
GET {{baseUrl}}/api/usuarios/{{id}}
Authorization: Bearer {{token}}

###

### 400 — id no es entero positivo
GET {{baseUrl}}/api/usuarios/abc
Authorization: Bearer {{token}}

###

### 404 — no existe
GET {{baseUrl}}/api/usuarios/99999
Authorization: Bearer {{token}}
