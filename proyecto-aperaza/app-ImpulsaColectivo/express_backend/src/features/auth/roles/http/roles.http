@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature Roles — CRUD
### Leyenda: SIN AUTH (temporal hasta ISS-21).
### El NOMBRE del rol no autoriza nada: la autorización son las filas de `resource_roles`.
@baseUrl = http://localhost:4000
### Roles sembrados: 1 = ADMIN, 2 = PROMOTER, 3 = CONTRIBUTOR. El rol nuevo será el 4.
@id = 4

# @name getAllRoles
GET {{baseUrl}}/api/roles
Authorization: Bearer {{token}}

###

# @name getOneRole
GET {{baseUrl}}/api/roles/2
Authorization: Bearer {{token}}

###

### CREATE — nace SIN permisos
# @name createRole
POST {{baseUrl}}/api/roles
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "AUDITOR",
  "description": "Solo lectura de proyectos y auditorías"
}

###

### 409 — el nombre ya existe
POST {{baseUrl}}/api/roles
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "promoter",
  "description": "Duplicado"
}

###

# @name updateRolePut
PUT {{baseUrl}}/api/roles/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "AUDITOR",
  "description": "Solo lectura de proyectos, aportes y auditorías"
}

###

# @name updateRolePatch
PATCH {{baseUrl}}/api/roles/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "description": "Auditoría operativa de la plataforma"
}

###

### DELETE lógico — todos sus usuarios pierden ese rol
# @name deactivateRole
PATCH {{baseUrl}}/api/roles/{{id}}/deactivate
Authorization: Bearer {{token}}

###

# @name deleteRolePhysical
DELETE {{baseUrl}}/api/roles/{{id}}
Authorization: Bearer {{token}}
