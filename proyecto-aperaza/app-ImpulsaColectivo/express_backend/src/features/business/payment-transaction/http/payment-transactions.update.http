@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature PaymentTransaction — UPDATE

PUT http://localhost:4000/api/transacciones-pago/1
Authorization: Bearer {{token}}
Content-Type: application/json
# @name updatePaymentTransactionPut

{
  "reference": "TRX-0001",
  "payment_method": "pse",
  "amount": 60000,
  "transaction_date": "2026-09-29",
  "contribution_id": 1,
  "status": "active"
}

###

PATCH http://localhost:4000/api/transacciones-pago/1
Authorization: Bearer {{token}}
Content-Type: application/json
# @name updatePaymentTransactionPatch

{
  "amount": 70000
}
