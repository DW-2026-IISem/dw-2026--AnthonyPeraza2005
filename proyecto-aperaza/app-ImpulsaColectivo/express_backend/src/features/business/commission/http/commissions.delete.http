@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature Commission — DELETE

DELETE http://localhost:4000/api/comisiones/1
Authorization: Bearer {{token}}
# @name deleteCommissionPhysical

###

PATCH http://localhost:4000/api/comisiones/1/deactivate
Authorization: Bearer {{token}}
# @name deleteCommissionLogical
