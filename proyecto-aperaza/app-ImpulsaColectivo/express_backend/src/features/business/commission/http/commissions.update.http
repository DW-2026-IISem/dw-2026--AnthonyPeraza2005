@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature Commission — UPDATE

PUT http://localhost:4000/api/comisiones/1
Authorization: Bearer {{token}}
Content-Type: application/json
# @name updateCommissionPut

{
  "percentage": 6,
  "amount": 3000,
  "calculation_date": "2026-09-29",
  "payment_transaction_id": 1,
  "status": "active"
}

###

PATCH http://localhost:4000/api/comisiones/1
Authorization: Bearer {{token}}
Content-Type: application/json
# @name updateCommissionPatch

{
  "amount": 3200
}
