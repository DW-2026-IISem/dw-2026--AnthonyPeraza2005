@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature Commission — CREATE

POST http://localhost:4000/api/comisiones
Authorization: Bearer {{token}}
Content-Type: application/json
# @name createCommission

{
  "percentage": 5.5,
  "amount": 2750,
  "calculation_date": "2026-09-29",
  "payment_transaction_id": 1,
  "status": "active"
}
