@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature ProjectAudit — DELETE

DELETE http://localhost:4000/api/auditorias-proyecto/1
Authorization: Bearer {{token}}
# @name deleteProjectAuditPhysical

###

PATCH http://localhost:4000/api/auditorias-proyecto/1/deactivate
Authorization: Bearer {{token}}
# @name deleteProjectAuditLogical
