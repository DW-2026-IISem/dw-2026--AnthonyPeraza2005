@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature ProjectAudit — UPDATE

PUT http://localhost:4000/api/auditorias-proyecto/1
Authorization: Bearer {{token}}
Content-Type: application/json
# @name updateProjectAuditPut

{
  "action": "edicion_meta",
  "detail": "Se actualizó la meta de financiación",
  "audit_date": "2026-09-29",
  "project_id": 1,
  "status": "active"
}

###

PATCH http://localhost:4000/api/auditorias-proyecto/1
Authorization: Bearer {{token}}
Content-Type: application/json
# @name updateProjectAuditPatch

{
  "detail": "Se corrigió la descripción del proyecto"
}
