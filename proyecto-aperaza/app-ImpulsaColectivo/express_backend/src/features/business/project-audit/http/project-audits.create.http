@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature ProjectAudit — CREATE

POST http://localhost:4000/api/auditorias-proyecto
Authorization: Bearer {{token}}
Content-Type: application/json
# @name createProjectAudit

{
  "action": "cambio_estado",
  "detail": "El proyecto pasó de inactivo a activo",
  "audit_date": "2026-09-29",
  "project_id": 1,
  "status": "active"
}
