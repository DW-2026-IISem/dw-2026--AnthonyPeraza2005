@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature Goal — CREATE
### Leyenda: SIN AUTH (sin middleware JWT / sin autenticación)
@baseUrl = http://localhost:4000

# @name createGoal
POST {{baseUrl}}/api/metas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "description": "Recaudar $8.000.000 para insumos de siembra",
  "target_amount": 8000000,
  "project_id": 1,
  "status": "active"
}
