@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature Goal — UPDATE (PUT) / UPDATE (PATCH)
### Leyenda: SIN AUTH (sin middleware JWT / sin autenticación)
@baseUrl = http://localhost:4000
@id = 1

# @name updateGoalPut
PUT {{baseUrl}}/api/metas/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "description": "Recaudar $10.000.000 para insumos de siembra",
  "target_amount": 10000000,
  "project_id": 1,
  "status": "active"
}

###

# @name updateGoalPatch
PATCH {{baseUrl}}/api/metas/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "target_amount": 9000000
}
