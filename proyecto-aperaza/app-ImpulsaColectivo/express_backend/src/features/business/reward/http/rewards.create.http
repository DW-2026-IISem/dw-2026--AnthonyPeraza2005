@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature Reward — CREATE
### Leyenda: SIN AUTH (sin middleware JWT / sin autenticación)
@baseUrl = http://localhost:4000

# @name createReward
POST {{baseUrl}}/api/recompensas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Camiseta conmemorativa",
  "description": "Camiseta del proyecto para aportes desde $50.000",
  "min_amount": 50000,
  "project_id": 1,
  "status": "active"
}
