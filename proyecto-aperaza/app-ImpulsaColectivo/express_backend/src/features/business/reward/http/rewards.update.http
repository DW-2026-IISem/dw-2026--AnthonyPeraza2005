@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature Reward — UPDATE (PUT) / UPDATE (PATCH)
### Leyenda: SIN AUTH (sin middleware JWT / sin autenticación)
@baseUrl = http://localhost:4000
@id = 1

# @name updateRewardPut
PUT {{baseUrl}}/api/recompensas/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Camiseta conmemorativa edición especial",
  "description": "Camiseta actualizada con nuevo diseño",
  "min_amount": 60000,
  "project_id": 1,
  "status": "active"
}

###

# @name updateRewardPatch
PATCH {{baseUrl}}/api/recompensas/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "min_amount": 55000
}
