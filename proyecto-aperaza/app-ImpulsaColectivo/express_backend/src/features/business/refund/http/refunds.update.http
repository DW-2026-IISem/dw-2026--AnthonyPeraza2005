@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature Refund — UPDATE

PUT http://localhost:4000/api/reembolsos/1
Authorization: Bearer {{token}}
Content-Type: application/json
# @name updateRefundPut

{
  "amount": 55000,
  "reason": "Solicitud del contribuyente",
  "refund_date": "2026-09-29",
  "contribution_id": 1,
  "status": "active"
}

###

PATCH http://localhost:4000/api/reembolsos/1
Authorization: Bearer {{token}}
Content-Type: application/json
# @name updateRefundPatch

{
  "amount": 60000
}
