@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature Refund — CREATE

POST http://localhost:4000/api/reembolsos
Authorization: Bearer {{token}}
Content-Type: application/json
# @name createRefund

{
  "amount": 50000,
  "reason": "El proyecto no alcanzó la meta de financiación",
  "refund_date": "2026-09-29",
  "contribution_id": 1,
  "status": "active"
}
