@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature Disbursement — CREATE

POST http://localhost:4000/api/desembolsos
Authorization: Bearer {{token}}
Content-Type: application/json
# @name createDisbursement

{
  "amount": 200000,
  "disbursement_date": "2026-09-29",
  "method": "transferencia_bancaria",
  "project_id": 1,
  "status": "active"
}
