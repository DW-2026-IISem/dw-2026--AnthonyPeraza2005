@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature Disbursement — GET

GET http://localhost:4000/api/desembolsos
Authorization: Bearer {{token}}
# @name getDisbursements

###

GET http://localhost:4000/api/desembolsos/1
Authorization: Bearer {{token}}
# @name getDisbursement
