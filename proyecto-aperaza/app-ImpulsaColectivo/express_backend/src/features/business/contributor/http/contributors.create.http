@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature Contributor — CREATE
### Leyenda: SIN AUTH (sin middleware JWT / sin autenticación)
@baseUrl = http://localhost:4000

# @name createContributor
POST {{baseUrl}}/api/contribuyentes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Mariana Torres",
  "email": "mariana.torres@example.com",
  "phone": "3007654321",
  "status": "active"
}
