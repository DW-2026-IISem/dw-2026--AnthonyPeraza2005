@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature Contributor — UPDATE (PUT) / UPDATE (PATCH)
### Leyenda: SIN AUTH (sin middleware JWT / sin autenticación)
@baseUrl = http://localhost:4000
@id = 1

# @name updateContributorPut
PUT {{baseUrl}}/api/contribuyentes/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Mariana Torres Actualizada",
  "email": "mariana.torres@example.com",
  "phone": "3001112233",
  "status": "active"
}

###

# @name updateContributorPatch
PATCH {{baseUrl}}/api/contribuyentes/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "phone": "3004445566"
}
