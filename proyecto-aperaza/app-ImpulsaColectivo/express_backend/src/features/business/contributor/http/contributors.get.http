@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature Contributor — GET ALL / GET ONE
### Leyenda: SIN AUTH (sin middleware JWT / sin autenticación)
@baseUrl = http://localhost:4000
@id = 1

# @name getAllContributors
GET {{baseUrl}}/api/contribuyentes
Authorization: Bearer {{token}}

###

# @name getOneContributor
GET {{baseUrl}}/api/contribuyentes/{{id}}
Authorization: Bearer {{token}}
