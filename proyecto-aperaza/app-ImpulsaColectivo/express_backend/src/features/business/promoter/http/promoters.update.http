@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature Promoter — UPDATE (PUT) / UPDATE (PATCH)
### Leyenda: SIN AUTH (sin middleware JWT / sin autenticación)
@baseUrl = http://localhost:4000
@id = 1

# @name updatePromoterPut
PUT {{baseUrl}}/api/promotores/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Fundación ImpulsaColectivo Actualizada",
  "description": "Organización actualizada que impulsa proyectos comunitarios",
  "contact_email": "contacto@impulsacolectivo.org",
  "contact_phone": "3009876543",
  "status": "active"
}

###

# @name updatePromoterPatch
PATCH {{baseUrl}}/api/promotores/{{id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "contact_phone": "3011112233"
}
