@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature Promoter — DELETE físico / DELETE lógico (status = inactive)
### Leyenda: SIN AUTH (sin middleware JWT / sin autenticación)
@baseUrl = http://localhost:4000
@id = 1

# @name deletePromoterPhysical
DELETE {{baseUrl}}/api/promotores/{{id}}
Authorization: Bearer {{token}}

###

# @name deletePromoterLogical
PATCH {{baseUrl}}/api/promotores/{{id}}/deactivate
Authorization: Bearer {{token}}
