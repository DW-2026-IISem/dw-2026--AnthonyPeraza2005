@baseUrl = http://localhost:4000

### Login (token de este archivo; admin tiene los 110 permisos)
# @name login
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

###
@token = {{login.response.body.$.access_token}}

### Feature Project — CREATE
### Leyenda: SIN AUTH (sin middleware JWT / sin autenticación)
@baseUrl = http://localhost:4000

# @name createProject
POST {{baseUrl}}/api/proyectos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Reforestación del río Rancheria",
  "description": "Proyecto comunitario de siembra de árboles nativos",
  "start_date": "2026-10-01",
  "end_date": "2026-12-31",
  "promoter_id": 1,
  "status": "active"
}
